datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String       @id @default(uuid())
  name              String
  email             String       @unique
  passwordHash      String
  phone             String?
  role              String       @default("CUSTOMER") // "CUSTOMER" | "ADMIN"
  passwordChangedAt DateTime?    @map("password_changed_at")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  orders            Order[]
  cart              Cart?
  wishlist          Wishlist?
  reviews           Review[]
  addresses         Address[]
  userOtps          UserOtp[]
  authSessions      AuthSession[]
}

model UserOtp {
  id          String    @id @default(uuid())
  userId      String?   @map("user_id")
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  otpCode     String    @map("otp_code")
  purpose     String    @default("PASSWORD_RESET")
  isUsed      Boolean   @default(false) @map("is_used")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([email, purpose, isUsed])
  @@map("user_otps")
}

model AuthSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("auth_sessions")
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  flatBuilding String   @default("")
  streetArea   String   @default("")
  landmark     String?
  city         String
  state        String
  pinCode      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  driveFileId String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  shortDescription String
  description      String
  price            Float
  compareAtPrice   Float?
  rootPrice        Float?
  auraPrice        Float?
  divinePrice      Float?
  energyRitualPrice Float?          @default(150.0)
  energyRitualDesc String?          @default("Your bracelet will be purified and energized through sacred rituals to enhance protection, confidence, and success energy.")
  structuredContent Json?
  sku              String           @unique
  barcode          String?
  mpn              String?
  stockQuantity    Int              @default(20)
  inStock          Boolean          @default(true)
  isFeatured       Boolean          @default(false)
  isBestSeller     Boolean          @default(false)
  isNewArrival     Boolean          @default(false)
  isPersonalized   Boolean          @default(false)

  // Astrology & Spiritual Attributes (REHAS Sacred Merchandise)
  beadSize         String?          @default("8mm")
  primaryCrystal   String?          
  associatedChakra String?          
  rulingPlanet     String?          
  zodiacSigns      String?          
  mulankNumber     String?          
  energizedBy      String?          @default("Blessed & Energized by Vedic Rituals")

  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  primaryImage     String
  images           ProductImage[]
  variants         ProductVariant[]
  reviews          Review[]
  orderItems       OrderItem[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]

  // Advanced Product SEO
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  canonicalUrl     String?
  ogTitle          String?
  ogDescription    String?
  ogImage          String?
  twitterTitle     String?
  twitterDescription String?
  twitterImage     String?
  indexable        Boolean          @default(true)

  rating           Float            @default(4.9)
  reviewCount      Int              @default(0)

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  driveFileId String?
  altText     String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ProductVariant {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  wristSize   String   
  beadSize    String?  
  priceAdjust Float    @default(0)
  stock       Int      @default(15)
  sku         String?
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  wristSize String?
  energized Boolean  @default(true)
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
}

model Order {
  id                 String      @id @default(uuid())
  orderNumber        String      @unique
  userId             String?
  user               User?       @relation(fields: [userId], references: [id])
  customerName       String
  customerEmail      String
  customerPhone      String

  // Indian Address Details
  flatBuilding       String
  streetArea         String
  landmark           String?
  city               String
  state              String
  pinCode            String

  subtotal           Float
  discountAmount     Float       @default(0)
  couponCode         String?
  shippingFee        Float       @default(0)
  taxAmount          Float       @default(0)
  totalAmount        Float

  paymentMethod      String      // "RAZORPAY" | "COD"
  paymentStatus      String      @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?

  shippingStatus     String      @default("PROCESSING") // PROCESSING, SHIPPED, DELIVERED, REFUNDED
  trackingNumber     String?
  trackingCourier    String?     @default("Shiprocket Express")

  items              OrderItem[]
  payments           Payment[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  wristSize String?
}

model Payment {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String   @default("RAZORPAY")
  paymentId   String
  amount      Float
  currency    String   @default("INR")
  status      String
  rawResponse String?
  createdAt   DateTime @default(now())
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountPct   Float     @default(10) // 10%
  minOrderValue Float     @default(499)
  maxDiscount   Float?
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  author    String
  rating    Int      @default(5)
  comment   String
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Blog {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  summary     String
  content     String
  imageUrl    String
  author      String   @default("Astro Acharya - REHAS")
  tags        String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ShippingConfig {
  id                    Int     @id @default(1)
  freeShippingThreshold Float   @default(999.0)
  flatRate              Float   @default(79.0)
  codEnabled            Boolean @default(true)
  codFee                Float   @default(49.0)
  gstPercentage         Float   @default(18.0)
  serviceablePinCodes   String?
}
